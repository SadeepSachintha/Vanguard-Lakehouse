# Project Nessie Catalog Configuration
# Nessie is an Iceberg REST / Git-like catalog offering branching, tagging, and time-travel

# Nessie service port
NESSIE_PORT=19120

# Nessie REST URL for clients (PyIceberg, DuckDB, Trino, Spark)
NESSIE_URI=http://nessie:19120/api/v1
NESSIE_CLIENT_URI=http://localhost:19120/api/v1

# Default branch
NESSIE_DEFAULT_BRANCH=main

# S3/MinIO Storage Configuration for Iceberg Catalog Warehouse
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_CLIENT_ENDPOINT=http://localhost:9000

# Iceberg Warehouse S3 location in MinIO
ICEBERG_WAREHOUSE_BUCKET=warehouse
ICEBERG_WAREHOUSE_S3A=s3a://warehouse/
ICEBERG_WAREHOUSE_S3=s3://warehouse/

# Lakehouse Storage Buckets
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
GOLD_BUCKET=gold
